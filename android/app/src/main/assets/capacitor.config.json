{
	"appId": "com.gigsconnect.app",
	"appName": "GigsConnect",
	"webDir": "dist",
	"plugins": {
		"Keyboard": {
			"resize": "body",
			"style": "dark",
			"resizeOnFullScreen": true
		},
		"SplashScreen": {
			"launchShowDuration": 2000,
			"backgroundColor": "#0F0F12",
			"androidSplashResourceName": "splash",
			"androidScaleType": "CENTER_CROP",
			"showSpinner": false
		},
		"StatusBar": {
			"style": "DARK",
			"backgroundColor": "#0F0F12"
		}
	},
	"server": {
		"androidScheme": "https",
		"iosScheme": "https",
		"cleartext": true
	}
}
